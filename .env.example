# Copy to .env (scripts/setup.ps1 does this) and fill in ANTHROPIC_API_KEY.

# Anthropic (used by both OpenWiki and the LangChain agent)
ANTHROPIC_API_KEY=
OPENWIKI_PROVIDER=anthropic
# Model OpenWiki uses to write the semantic wiki (Sonnet for quality)
OPENWIKI_MODEL_ID=claude-sonnet-5-5
# Cheaper model for context-graph (memory) syncs
CONTEXT_OPENWIKI_MODEL_ID=claude-haiku-4-5-20251001
# Model the Q&A agent uses (langchain-anthropic)
AGENT_MODEL_ID=claude-sonnet-5-5
OPENWIKI_PAGE_CONCURRENCY=3
# Parallel page writers for memory syncs (an update after one turn took ~5 min at 6)
CONTEXT_OPENWIKI_PAGE_CONCURRENCY=6
# Keeps OpenWiki non-interactive when there is no LangSmith key
LANGCHAIN_TRACING_V2=false
OPENWIKI_TELEMETRY_DISABLED=1
# Resolved to an absolute path by the backend and scripts
OPENWIKI_CONFIG_DIR=.openwiki-state
# Optional override for <npm root -g>/openwiki/dist/cli/cli.js
OPENWIKI_CLI_JS=

# Paths and ports
SEMANTIC_CORPUS_DIR=semantic-corpus
CONTEXT_CORPUS_DIR=context-corpus
SEMANTIC_VIS_PORT=4321
CONTEXT_VIS_PORT=4322
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Behaviour
# Demo mode: wipe agent memory on every backend start
RESET_CONTEXT_ON_START=true
# per_turn | manual
MEMORY_SYNC_MODE=per_turn
MEMORY_SYNC_TIMEOUT_SEC=1200
